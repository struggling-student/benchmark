# Copy this file to a private path (for example, sapienza.env), edit it, and set
# BENCH_CONFIG to that path before running scripts. This is sourced as shell code.
# Do not put HF_TOKEN or any other secret here.

# Optional commands required to expose Python/CUDA at your site. This value is
# evaluated in the current shell so that module changes persist. Leave empty if
# modules are not needed. Replace the placeholder only after inspecting `module avail`.
export MODULE_COMMANDS=""
# Example form only: MODULE_COMMANDS="module purge; module load <PYTHON_MODULE> <CUDA_MODULE>"

# Python used to create the virtual environment. Determine it on the cluster first.
export PYTHON_EXECUTABLE="<ABSOLUTE_PATH_OR_COMMAND_FOR_COMPATIBLE_PYTHON>"

# Absolute path to this Git checkout. Slurm copies job scripts to a spool directory,
# so jobs cannot reliably discover the repository from BASH_SOURCE.
export BENCH_REPO_ROOT="<ABSOLUTE_PATH_TO_BENCHMARK_REPOSITORY_CHECKOUT>"

# Absolute paths selected after checking project/scratch policy and quota.
export VENV_PATH="<ABSOLUTE_PATH_TO_VIRTUAL_ENV>"
export HF_HOME="<ABSOLUTE_PATH_TO_HUGGING_FACE_CACHE_ROOT>"
export MODEL_CACHE_DIR="<ABSOLUTE_PATH_TO_MODEL_CACHE>"
export MODEL_ARTIFACT_ROOT="<ABSOLUTE_PATH_TO_PREPARED_MODEL_ARTIFACTS>"
export RESULTS_ROOT="<ABSOLUTE_PATH_TO_BENCHMARK_RESULTS>"

# Native backend locations. GPU vLLM may use PATH when VLLM_BIN is empty. The
# CPU profile requires VLLM_CPU_BIN so it cannot silently select a GPU wheel.
export VLLM_BIN=""
export VLLM_CPU_BIN=""
export LLAMA_CPP_BIN_DIR=""
# CPU ISA profiles select a distinct build directory. These builds must have
# the corresponding ISA enabled; the AVX-512 build should have AMX disabled so
# an AVX-512 treatment cannot silently become an AMX treatment.
export LLAMA_CPP_AVX2_BIN_DIR=""
export LLAMA_CPP_AVX512_BIN_DIR=""
export LLAMA_CPP_AMX_BIN_DIR=""
export LLAMA_CPP_CONVERT_SCRIPT=""
export LLAMA_CPP_QUANTIZE_BIN=""

# Container references must be pinned by digest. Configure only the providers used.
export LLAMA_CPP_DOCKER_IMAGE="ghcr.io/ggml-org/llama.cpp:full@sha256:<DIGEST>"
export LLAMA_CPP_AVX2_DOCKER_IMAGE=""
export LLAMA_CPP_AVX512_DOCKER_IMAGE=""
export LLAMA_CPP_AMX_DOCKER_IMAGE=""
export LLAMA_CPP_APPTAINER_IMAGE="docker://ghcr.io/ggml-org/llama.cpp:full@sha256:<DIGEST>"
export LLAMA_CPP_AVX2_APPTAINER_IMAGE=""
export LLAMA_CPP_AVX512_APPTAINER_IMAGE=""
export LLAMA_CPP_AMX_APPTAINER_IMAGE=""
export VLLM_DOCKER_IMAGE=""
export VLLM_APPTAINER_IMAGE=""
export VLLM_CPU_DOCKER_IMAGE=""
export VLLM_CPU_APPTAINER_IMAGE=""

# Slurm values are deliberately blank. Supply the corresponding `sbatch` options
# on the command line after discovering the valid site values. Scripts never invent
# these settings and the sbatch files contain no site-specific resource directives.
export SLURM_PARTITION=""
export SLURM_ACCOUNT=""
export SLURM_QOS=""
export SLURM_GPU_REQUEST=""
export SLURM_TIME_LIMIT=""

# Optional runtime controls. One GPU / tensor-parallel size 1 is the initial example.
# Change the port if it conflicts with another process in the same allocation.
export LLM_BENCH_HOST="127.0.0.1"
export LLM_BENCH_PORT=""
export LLM_BENCH_STARTUP_TIMEOUT_SECONDS="600"

# Diagnostic verbosity for the whole job allocation: DEBUG, INFO (default),
# WARNING, ERROR, or CRITICAL. Applies to every llm-bench invocation that
# sources this file, so it can be raised to DEBUG for one troubleshooting job
# without editing any script. `llm-bench --log-level` overrides this per call.
export LLM_BENCH_LOG_LEVEL="INFO"
