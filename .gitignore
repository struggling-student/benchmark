# Python environments and generated package files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Local cluster configuration and credentials
configs/cluster/*.env
!configs/cluster/sapienza.example.env
.env
.env.*
!.env.example

# Model caches and downloaded weights must stay outside Git
model-cache/
models/
!configs/models/
!configs/models/*.yaml
huggingface-cache/
*.safetensors
*.bin
*.gguf
*.sif

# Benchmark products (retain only the empty-directory marker)
results/*
!results/.gitkeep
membench-results/

# Downloaded/proprietary tools that cannot be committed (see
# docs/07_MEMORY_BANDWIDTH_MICROBENCHMARK.md) -- `build/` above already covers
# scripts/membench/build/.
scripts/membench/vendor/

# Local scratch: extracted paper text, PDFs, and other working material
tmp/

# Slurm and local run logs
slurm-*.out
slurm-*.err
*.log

# Editors and operating systems
.DS_Store
.idea/
.vscode/
